venv/
__pycache__/
*.pyc
.env
# /data/ and /logs/ (rooted, not "data/") so this doesn't also swallow the permanent qa/data/
# dataset below - only the top-level data/ and logs/ directories are runtime/gitignored.
/data/
/logs/
*.db
*.sqlite3
*.csv
*.log
# qa/data/ is the permanent, checked-in frozen test dataset - exempt from the blanket *.csv rule.
!qa/data/*.csv

# Personal job-search data: which jobs were applied to / deleted (the prompt-eval labels) and the per-job
# scores keyed to them. Kept local - the GitHub repo is public. Rebuild with qa/collect_ground_truth.py.
qa/data/ground_truth.json
qa/data/prompt_eval_results.json
